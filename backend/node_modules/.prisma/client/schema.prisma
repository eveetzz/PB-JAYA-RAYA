// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// inisiasi tabel  
enum RoleUser {
  Admin
  Manajemen
  Atlet
  Pelatih
  Official
}

enum StatusAkun {
  Aktif
  Nonaktif
}

enum StatusAktivitas {
  Aktif
  Nonaktif
}

enum JenisKelamin {
  L
  P
}

enum PeganganRaket {
  Kanan
  Kiri
}

enum JenisPelatih {
  pelatih_teknik
  pelatih_fisik
}

enum KategoriSektor {
  Fisik
  Teknik
}

model MUser {
  uidUser            String     @id @default(uuid()) @db.VarChar(36)
  email              String     @db.VarChar(100)
  password           String     @db.VarChar(255)
  role               RoleUser
  statusAkun         StatusAkun @default(Aktif)
  mustChangePassword Boolean    @default(true)
  passwordChangedAt  DateTime?

  uidAtlet    String? @unique @db.VarChar(36)
  uidPelatih  String? @unique @db.VarChar(36)
  uidOfficial String? @unique @db.VarChar(36)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String    @db.VarChar(36)
  updatedBy String    @db.VarChar(36)
  deletedBy String?   @db.VarChar(36)

  atlet    MAtlet?    @relation("UserAtlet", fields: [uidAtlet], references: [uidAtlet])
  pelatih  MPelatih?  @relation("UserPelatih", fields: [uidPelatih], references: [uidPelatih])
  official MOfficial? @relation("UserOfficial", fields: [uidOfficial], references: [uidOfficial])
}

model MAtlet {
  uidAtlet      String          @id @default(uuid()) @db.VarChar(36)
  nik           String          @db.VarChar(20)
  idPbsi        String          @db.VarChar(20)
  namaLengkap   String          @db.VarChar(100)
  namaIbu       String          @db.VarChar(100)
  tempatLahir   String          @db.VarChar(100)
  tanggalLahir  DateTime        @db.Date
  alamat        String          @db.Text
  jenisKelamin  JenisKelamin
  peganganRaket PeganganRaket
  provinsi      String          @db.VarChar(100)
  statusAtlet   StatusAktivitas @default(Aktif)

  klubSaatIni        String    @db.VarChar(100)
  asalKlubSebelumnya String?   @db.VarChar(100)
  gabungSatelitPada  DateTime? @db.Date
  gabungJayaRayaPada DateTime? @db.Date

  foto              String? @db.VarChar(255)
  fileSttbSd        String? @db.VarChar(255)
  fileKk            String? @db.VarChar(255)
  fileNisnOnline    String? @db.VarChar(255)
  fileAkteKelahiran String? @db.VarChar(255)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String    @db.VarChar(36)
  updatedBy String    @db.VarChar(36)
  deletedBy String?   @db.VarChar(36)

  user MUser? @relation("UserAtlet")
}

model MPelatih {
  uidPelatih              String          @id @default(uuid()) @db.VarChar(36)
  nik                     String          @db.VarChar(20)
  namaLengkap             String          @db.VarChar(100)
  jenisKelamin            JenisKelamin
  tanggalLahir            DateTime        @db.Date
  tahunBergabung          Int
  kewarganegaraan         String          @default("Indonesia") @db.VarChar(50)
  pernahMelatihSebelumnya Boolean         @default(false)
  klubNegaraSebelumnya    String?         @db.VarChar(100)
  statusPelatih           StatusAktivitas @default(Aktif)

  foto                           String? @db.VarChar(255)
  fileSertifikasiKota            String? @db.VarChar(255)
  fileSertifikasiProvinsi        String? @db.VarChar(255)
  fileSertifikasiNasional        String? @db.VarChar(255)
  fileSertifikasiBwf1            String? @db.VarChar(255)
  fileSertifikasiBwf2            String? @db.VarChar(255)
  fileSertifikasiSarjanaOlahraga String? @db.VarChar(255)
  fileSertifikasiMasterOlahraga  String? @db.VarChar(255)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String    @db.VarChar(36)
  updatedBy String    @db.VarChar(36)
  deletedBy String?   @db.VarChar(36)

  user MUser? @relation("UserPelatih")

  pelatihSektorList RPelatihSektor[] @relation("PelatihRPelatihSektor")
  pelatihJenisList  RPelatihJenis[]  @relation("PelatihRPelatihJenis")
}

model MOfficial {
  uidOfficial    String          @id @default(uuid()) @db.VarChar(36)
  nik            String          @db.VarChar(20)
  namaLengkap    String          @db.VarChar(100)
  nomorTelp      String          @db.VarChar(20)
  tempatLahir    String          @db.VarChar(100)
  tanggalLahir   DateTime        @db.Date
  jenisKelamin   JenisKelamin
  statusOfficial StatusAktivitas @default(Aktif)
  foto           String?         @db.VarChar(255)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String    @db.VarChar(36)
  updatedBy String    @db.VarChar(36)
  deletedBy String?   @db.VarChar(36)

  user MUser? @relation("UserOfficial")
}

model MSektor {
  uidSektor  String         @id @default(uuid()) @db.VarChar(36)
  namaSektor String         @db.VarChar(50)
  kategori   KategoriSektor @default(Teknik)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String    @db.VarChar(36)
  updatedBy String    @db.VarChar(36)
  deletedBy String?   @db.VarChar(36)

  pelatihSektorList RPelatihSektor[] @relation("SektorRPelatihSektor")
}

model RPelatihJenis {
  uidJenis     String       @id @default(uuid()) @db.VarChar(36)
  uidPelatih   String       @db.VarChar(36)
  jenisPelatih JenisPelatih

  startDate DateTime  @default(now())
  endDate   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String    @db.VarChar(36)
  updatedBy String    @db.VarChar(36)
  deletedBy String?   @db.VarChar(36)

  pelatih MPelatih @relation("PelatihRPelatihJenis", fields: [uidPelatih], references: [uidPelatih])
}

model RPelatihSektor {
  uidRelasi  String @id @default(uuid()) @db.VarChar(36)
  uidPelatih String @db.VarChar(36)
  uidSektor  String @db.VarChar(36)

  startDate DateTime  @default(now())
  endDate   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  createdBy String    @db.VarChar(36)
  updatedBy String    @db.VarChar(36)
  deletedBy String?   @db.VarChar(36)

  pelatih MPelatih @relation("PelatihRPelatihSektor", fields: [uidPelatih], references: [uidPelatih])
  sektor  MSektor  @relation("SektorRPelatihSektor", fields: [uidSektor], references: [uidSektor])
}
